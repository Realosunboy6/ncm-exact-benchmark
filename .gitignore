*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Python / Julia
__pycache__/
*.pyc
.deps/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

